{
  "name": "jewelry-vector-search",
  "version": "1.0.0",
  "description": "AI-powered jewelry image search — Pinecone + OpenAI + Express + React",
  "type": "module",
  "scripts": {
    "setup": "node src/setup.js",
    "reset": "node src/resetIndex.js",
    "backend": "node --watch backend/server.js",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "add": "node examples/addJewelry.js",
    "search": "node examples/search.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^3.0.0",
    "basic-ftp": "^6.0.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.52.0",
    "sanitize-filename": "^1.6.4",
    "sharp": "^0.33.4",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}